# Scaffold Server configuration. Copy to .env for local runs; never commit .env.
# Precedence: process environment > .env > JSON file named by SCAFFOLD_CONFIG_FILE.
# Empty values count as unset. Booleans accept only: 1/0, true/false, yes/no, on/off.
#
# Variables marked [env only] are read from the process environment, never from this file
# (feature flags, transport): set them in your MCP client's `env` block or the container.

# --- Always required ----------------------------------------------------------------
# The upstream API every tool calls.
SCAFFOLD_UPSTREAM_BASE_URL=https://api.example.com/v1

# scaffold:if auth=none
# --- Auth mode: none (stdio only) ---------------------------------------------------
# Required. The upstream API key or personal access token the server acts with. The MCP
# spec recommends environment credentials for stdio servers. Treat it like a password.
SCAFFOLD_UPSTREAM_TOKEN=
# scaffold:end
# scaffold:if auth=proxy|auth=resource-server
# --- Upstream sign-in ---------------------------------------------------------------
# Required. OAuth client registered with the upstream (or your identity provider).
# Each deployed environment needs its own client: many providers allow one redirect URI
# per client.
SCAFFOLD_OAUTH_CLIENT_ID=
# Optional. Set for a confidential client; omit for a public client (PKCE only).
SCAFFOLD_OAUTH_CLIENT_SECRET=
# Required for sign-in. Authorization and token endpoints.
SCAFFOLD_OAUTH_AUTHORIZE_URL=
SCAFFOLD_OAUTH_TOKEN_URL=
# Optional. Space- or comma-separated scopes to request.
SCAFFOLD_OAUTH_SCOPES=
# stdio sign-in (scripts/oauth_login.py). The listener is parsed from this one value.
SCAFFOLD_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/callback
# Where stdio tokens are stored (0600). Default: ~/.scaffold-server/tokens.json
SCAFFOLD_TOKEN_FILE=
# Escape hatch for the client-id shape check. Only read when the check fails.
# SCAFFOLD_SKIP_CLIENT_ID_CHECK=false
# scaffold:end
# scaffold:if auth=proxy&http

# --- Proxy mode ---------------------------------------------------------------------
# Required for HTTP. Cheap "who am I" endpoint returning JSON with an "id" (and ideally
# "email"). Used to verify opaque upstream tokens and to identify the caller.
SCAFFOLD_USERINFO_URL=
# scaffold:end
# scaffold:if auth=resource-server&http

# --- Resource-server mode (HTTP) ----------------------------------------------------
# Required. Validation of inbound tokens issued for THIS server.
SCAFFOLD_JWKS_URI=
SCAFFOLD_ISSUER=
SCAFFOLD_AUDIENCE=
SCAFFOLD_AUTHORIZATION_SERVER=
# Required. Exchange of the inbound token for a per-user upstream token. The inbound token
# is never forwarded upstream (that would be token passthrough, forbidden by the MCP spec).
SCAFFOLD_EXCHANGE_TOKEN_URL=
SCAFFOLD_EXCHANGE_CLIENT_ID=
SCAFFOLD_EXCHANGE_CLIENT_SECRET=
# rfc8693 (Okta, Auth0, Keycloak, ...) or entra-obo (Microsoft Entra on-behalf-of).
SCAFFOLD_EXCHANGE_GRANT=rfc8693
SCAFFOLD_UPSTREAM_AUDIENCE=
SCAFFOLD_UPSTREAM_SCOPES=
# scaffold:end
# scaffold:if http

# --- HTTP transport -----------------------------------------------------------------
# [env only] stdio (default) or http.
# SCAFFOLD_TRANSPORT=stdio
# Required for HTTP. This server's canonical https URL (OAuth metadata, icons).
SCAFFOLD_PUBLIC_URL=
# scaffold:if auth=proxy
# Required for HTTP proxy mode. Signs the tokens the proxy issues. Without it the key is
# derived from the client secret, so rotating the secret would sign everyone out.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCAFFOLD_JWT_SIGNING_KEY=
# scaffold:end
# Optional. Host header allow-list (DNS-rebinding protection). Comma-separated.
SCAFFOLD_ALLOWED_HOSTS=
# Optional. Per-user tool-call rate limit per replica. Default 10.
SCAFFOLD_RATE_LIMIT_RPS=10
# [env only] Bind address. 0.0.0.0 in a container; use 127.0.0.1 on a laptop.
# SCAFFOLD_HTTP_HOST=0.0.0.0
# [env only] Port, usually set by the platform. Default 8080.
# PORT=8080
# scaffold:end

# --- Feature flags [env only] ---------------------------------------------------------
# New capabilities ship merged-but-off. Turn on with an env var and a restart.
# SCAFFOLD_FEATURE_WRITES=false

# --- Logging [env only] ---------------------------------------------------------------
# SCAFFOLD_LOG_LEVEL=INFO
